BACKEND_URL=http://localhost:8000

# Used only by the login page's "quick sign-in" buttons — must match
# backend/.env.example's values exactly, since the backend is still the
# sole authority that actually validates them. Leave blank to hide the
# quick-login buttons.
APP_USERNAME=ADMIN
APP_PASSWORD=change-me
SUPERADMIN_USERNAME=SuperAdmin
SUPERADMIN_PASSWORD=change-me
