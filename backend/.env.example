# ---- Gemini API ----
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4

# Comma-separated allowed frontend origin(s). "*" is fine for local dev only.
CORS_ORIGINS=*

# ---- Upload virus scanning (YARA) ----
YARA_ENABLED=true

# ---- Login lockout alerts ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

ALERT_ADMIN_EMAIL=
ALERT_ADMIN_MOBILE=
# Carrier email-to-SMS gateway domain, e.g. txt.att.net / vtext.com / tmomail.net.
# Leave blank to skip the SMS leg (email alert still sends).
ALERT_MOBILE_GATEWAY_DOMAIN=

# ---- JWT auth ----
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_EXPIRY_MINUTES=60

# ---- Built-in accounts (must match frontend/.env) ----
APP_USERNAME=ADMIN
APP_PASSWORD=change-me
SUPERADMIN_USERNAME=SuperAdmin
SUPERADMIN_PASSWORD=change-me
